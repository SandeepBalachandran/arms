# Copy to .env.local and fill in. For local dev, `npx supabase status` prints these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose in the browser.
SUPABASE_SECRET_KEY=

# Server-only. 32+ random chars. Encrypts gym Razorpay secrets and signs member QR tokens.
APP_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Flutter app: Android application id, and SHA-256 signing cert fingerprints
# (comma-separated) for /.well-known/assetlinks.json.
NEXT_PUBLIC_ANDROID_PACKAGE=com.gymos.app
ANDROID_SHA256_CERT_FINGERPRINTS=

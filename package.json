{
  "name": "gymos",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "npm run dev -w @gymos/web",
    "mobile": "npm run start -w @gymos/mobile",
    "mobile:web": "npm run web -w @gymos/mobile",
    "mobile:pwa": "npm run export:web -w @gymos/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tests/tsconfig.json",
    "lint": "npm run lint --workspaces --if-present",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "node scripts/db.mjs types",
    "db:push": "node scripts/db.mjs push",
    "db:types:local": "supabase gen types typescript --local --schema public > packages/shared/src/database.types.ts",
    "db:seed-demo": "node scripts/seed-demo.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "supabase": "^2.120.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}

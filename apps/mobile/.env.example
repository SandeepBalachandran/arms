# Copy to .env.local. Same Supabase project as apps/web.
# On the Android emulator with a local Supabase, use http://10.0.2.2:54321.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Domain the web app is deployed to; join links on it open the app.
EXPO_PUBLIC_APP_LINK_HOST=gymos.app

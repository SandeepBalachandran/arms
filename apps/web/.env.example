# Copy to .env.local and fill in.
# Supabase → Project Settings → API Keys (or `npx supabase status` for a local stack).

# Required
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Used to build email links and the WhatsApp join link. Your deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: not used yet (reserved for push notifications / server jobs).
# Server-only. Never expose in the browser.
SUPABASE_SECRET_KEY=

# Mobile app links: Android application id, and SHA-256 signing cert
# fingerprints (comma-separated) served at /.well-known/assetlinks.json.
# Only needed once the app is built with EAS.
NEXT_PUBLIC_ANDROID_PACKAGE=com.gymos.app
ANDROID_SHA256_CERT_FINGERPRINTS=

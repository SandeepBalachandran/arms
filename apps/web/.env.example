# Copy to .env.local and fill in.
# Supabase → Project Settings → API Keys (or `npx supabase status` for a local stack).

# Required
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Used to build email links and the WhatsApp join link. Your deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never expose in the browser or put it in the mobile app.
# Needed to add members from the admin and to show member emails.
SUPABASE_SECRET_KEY=
# Database password (Supabase → Project Settings → Database). Only used by
# `npm run db:push` / `npm run db:types` (scripts/db.mjs) on your machine.
SUPABASE_DB_PASSWORD=

# Mobile app links: Android application id, and SHA-256 signing cert
# fingerprints (comma-separated) served at /.well-known/assetlinks.json.
# Only needed once the app is built with EAS.
NEXT_PUBLIC_ANDROID_PACKAGE=com.gymos.app
ANDROID_SHA256_CERT_FINGERPRINTS=
